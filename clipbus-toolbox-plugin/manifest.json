{
  "schemaVersion": 6,
  "plugin": {
    "id": "plugin.toolbox",
    "title": "Toolbox",
    "version": "0.1.0"
  },
  "install": {
    "entry": "scripts/install.mjs"
  },
  "runtime": {
    "nodeEntry": "dist/plugin.cjs"
  },
  "detectors": [
    {
      "id": "base64-detector",
      "title": "Base64 Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "jwt-detector",
      "title": "JWT Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "xml-detector",
