  "renderers": [
    {
      "id": "base64-renderer",
      "title": "Base64 Decode",
      "attachmentType": "plugin.toolbox.base64",
      "height": {
        "min": 120,
        "max": 320
      },
      "page": "dist/ui/renderers/base64-renderer/index.html",
      "tint": "#0F766E",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy Decoded Result"
        }
      ]
    },
    {
      "id": "jwt-renderer",
      "title": "JWT Decoded",
      "attachmentType": "plugin.toolbox.jwt",
      "height": {
        "min": 140,
        "max": 440
      },
      "page": "dist/ui/renderers/jwt-renderer/index.html",
      "tint": "#7C3AED",
      "buttons": [
        {
          "id": "copy",
          "title": "Copy Payload"
        }
      ]
    },
    {
      "id": "xml-renderer",
      "title": "XML Formatter",
      "attachmentType": "plugin.toolbox.xml",
      "height": {
        "min": 140,
        "max": 480
      },
      "page": "dist/ui/renderers/xml-renderer/index.html",
      "tint": "#7C3AED",
      "buttons": [
