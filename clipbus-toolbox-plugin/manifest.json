      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "timestamp-detector",
      "title": "Unix Timestamp Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "radix-detector",
      "title": "Radix Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "duration-detector",
      "title": "Duration Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "entities-detector",
      "title": "Email / IPv4 Extraction Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "url-detector",
      "title": "URL / Query String Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "ip-detector",
      "title": "IP Address Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "geo-detector",
      "title": "Coordinates Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "mac-detector",
      "title": "MAC Address Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "uuid-detector",
      "title": "UUID Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "markdown-detector",
      "title": "Markdown Detector",
      "inputKinds": [
        "text"
      ]
    },
    {
      "id": "gradient-detector",
      "title": "Gradient Detector",
